# 사이트 공개 URL (sitemap, OG 이미지 절대경로에 사용)
NEXT_PUBLIC_SITE_URL=https://www.withthelake.com

# Google Analytics 4 측정 ID — 설정하면 자동으로 로드됩니다
NEXT_PUBLIC_GA_ID=

# CONTACT US 접수 메일 (Resend, https://resend.com) — 미설정 시 서버 로그에만 기록
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@withthelake.com
CONTACT_FROM_EMAIL=WITH THE LAKE <noreply@withthelake.com>

# 관리자 페이지 (/admin) — 최초 비밀번호. 관리자 화면 "설정" 에서 바꾸면 그 뒤로는
# content/admin-auth.json 의 해시가 쓰이고 이 값은 무시됩니다. (잊었을 때: npm run admin:password -- 새비밀번호)
ADMIN_PASSWORD=
# 로그인 세션 서명 키 (선택, 미설정 시 비밀번호에서 파생). 예: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# 콘텐츠 저장 위치 (선택) — 아래 중 하나. 둘 다 없으면 로컬 파일(content/, public/uploads/)에 저장합니다.
#
# (1) Supabase — 권장. Cloudflare · Vercel 등 파일이 유지되지 않는 서버용. supabase/schema.sql 을 먼저 실행하세요.
#     URL 과 service_role 키는 Supabase 대시보드 → Project Settings → API 에 있습니다. service_role 키는 서버 전용(절대 공개 금지).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads
#
# (2) GitHub 커밋 — 관리자에서 저장할 때 GitHub 저장소 content/site-content.json 에 커밋합니다. 토큰 권한: Contents(read/write)
CMS_GITHUB_TOKEN=
CMS_GITHUB_REPO=hsk9867-ai/withthelake-website
CMS_GITHUB_BRANCH=master
