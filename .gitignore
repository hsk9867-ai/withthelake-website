# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# raw uploaded asset sources (originals, not served)
/asset-sources

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the env template
!.env.example

# admin password hash (set via /admin/settings or `npm run admin:password`); keep out of the public repo
/content/admin-auth.json

# cloudflare (OpenNext build output, wrangler state, generated types)
/.open-next
/.wrangler
cloudflare-env.d.ts
